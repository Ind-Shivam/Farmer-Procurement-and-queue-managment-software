rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions for Authentication & Role-Based Access Control
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    function isStaff() {
      return isSignedIn() && (
        getUserData().role == 'staff' ||
        isAdmin() ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*staff.*'))
      );
    }

    // =========================================================================
    // 1. Users Collection (users/{uid})
    // Schema: { uid, name, email, role: 'farmer'|'staff'|'admin', mobile, createdAt }
    // =========================================================================
    match /users/{userId} {
      // Users can read their own profile; Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // New public signups must be assigned the 'farmer' role. Admins can create any role.
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'farmer') ||
        isAdmin()
      );

      // Users can update their own profile but cannot escalate their own role; Admins can edit anything
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Farmers Collection (farmers/{mobile})
    // =========================================================================
    match /farmers/{farmerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. Bookings Collection (bookings/{token})
    // =========================================================================
    match /bookings/{bookingId} {
      // Signed-in farmers, staff, and admins can view bookings
      allow read: if isSignedIn();

      // Farmers can create booking slot reservations
      allow create: if isSignedIn();

      // Staff and Admins can update procurement & payment status; Farmers can cancel
      allow update: if isStaff() || isAdmin() || (
        isSignedIn() && request.resource.data.status == 'Cancelled'
      );

      // Only admins can delete booking records
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. Procurement Centres & Slots (Centres Directory & Slot Capacity)
    // =========================================================================
    match /procurement_centres/{centreId} {
      allow read: if true; // Public/signed-in can view mandi locations
      allow write: if isAdmin() || isSignedIn();
    }

    match /slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 5. Notifications Collection (In-app Token & Status Notifications)
    // =========================================================================
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || isAdmin();
    }

    // =========================================================================
    // 6. System Metadata (Idempotent initial seeding)
    // =========================================================================
    match /_metadata/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
